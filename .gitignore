# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# clerk configuration (can include secrets)
/.clerk/

# local scratch / non-frontend files
/shotbase-backend-changes/
/tmp-extract/
/test-unkey.js
/uploads/

# strategy / planning artifacts — never commit
PLAN.md
ROADMAP.md
NOTES.md
*.plan.md
security-audit.md
someday.md
